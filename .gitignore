# .gitignore of atlbase

#
# Backups, temporary files, logs
#

*~
*.swp
*.swo
*.bak
*.orig
*.rej
*.tmp
*.log
*.pid
*.pid.lock
*.seed

#
# System files
#

.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

#
# Rust
#
# Cargo.lock is not committed: atlbase is a library, so the program that uses it decides which
# versions of the crates are used.
#

/target/
/vendor/
Cargo.lock

#
# Build results
#

/build/
/dist/
/out/
/po/*.mo
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

#
# Python
#

__pycache__/
*.py[cod]
*.egg-info/

#
# Node / JavaScript
#

node_modules/
npm-debug.log
yarn-error.log
pnpm-lock.yaml

#
# IDEs and editors
#

.vscode/
.idea/
*.iml
*.sublime-workspace
*.sublime-project
